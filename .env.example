# Copy to .env locally or configure these as deployment environment variables.
# Do not commit your real .env file to source control.
PORT=3000
RECAPTCHA_SECRET_KEY=PASTE_YOUR_RECAPTCHA_SECRET_KEY_HERE
RECAPTCHA_EXPECTED_HOSTNAME=example.com
RECAPTCHA_MIN_SCORE=0.5

# Paste your three external survey URLs here. HTTPS URLs only.
SURVEY_URL_1=https://example.com/replace-with-survey-one
SURVEY_URL_2=https://example.com/replace-with-survey-two
SURVEY_URL_3=https://example.com/replace-with-survey-three
